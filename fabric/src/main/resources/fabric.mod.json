{
  "schemaVersion": 1,
  "id": "unslotted",
  "version": "${version}",
  "name": "Unslotted",
  "description": "Removes a considerable portion of your inventory slots, turning them into a space you can drag items around freeform instead.",
  "authors": [
    "Yipeekiyaay"
  ],
  "contact": {
    "homepage": "https://github.com/Yuri-Almir-Pinto/kitchen-sink-inventory-mod",
    "sources": "https://github.com/Yuri-Almir-Pinto/kitchen-sink-inventory-mod"
  },
  "license": "MIT",
  "icon": "assets/unslotted/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.yipeekiyaay.unslotted.fabric.UnslottedModFabric"
    ],
    "client": [
      "com.yipeekiyaay.unslotted.fabric.client.UnslottedModFabricClient"
    ]
  },
  "mixins": [
    "unslotted.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.8",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
